# Ladder Company - Git attributes.
#
# Unreal binary assets are large and non-mergeable, so they are stored with
# Git LFS. Run `git lfs install` once per clone before pulling content.
#
# NOTE: Git LFS is a source-control convention established here for when binary
# assets start landing. No binary assets exist in the foundation commit yet.

# Unreal binary asset types -> Git LFS
*.uasset  filter=lfs diff=lfs merge=lfs -text
*.umap    filter=lfs diff=lfs merge=lfs -text

# Common binary media that may accompany assets
*.fbx     filter=lfs diff=lfs merge=lfs -text
*.png     filter=lfs diff=lfs merge=lfs -text
*.jpg     filter=lfs diff=lfs merge=lfs -text
*.tga     filter=lfs diff=lfs merge=lfs -text
*.wav     filter=lfs diff=lfs merge=lfs -text
*.mp3     filter=lfs diff=lfs merge=lfs -text
*.exr     filter=lfs diff=lfs merge=lfs -text

# Text-based project files are normalized to LF and diffed normally.
*.uproject text eol=lf
*.cpp      text
*.h        text
*.cs       text
*.ini      text
*.md       text
